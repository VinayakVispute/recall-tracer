{
  "name": "recall-tracer",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "tsx src/data/generate.ts",
    "mcp": "tsx src/mcp/server.ts",
    "api": "tsx watch src/api/server.ts",
    "web": "vite web",
    "dev": "concurrently -n api,web \"pnpm api\" \"pnpm web\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build web",
    "start": "tsx src/api/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cytoscape": "^3.34.3",
    "dotenv": "^18.0.8",
    "falkordb": "^6.8.0",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "seedrandom": "^3.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.31.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/seedrandom": "^3.0.8",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.9.0"
}
