{
  "name": "recall-tracer",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "tsx src/data/generate.ts",
    "mcp": "tsx src/mcp/server.ts",
    "api": "tsx watch src/api/server.ts",
    "web": "cd web && bun run dev",
    "dev": "concurrently -n api,web \"bun run api\" \"bun run web\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "cd web && bun run build",
    "start": "tsx src/api/server.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/mcp": "^2.0.78",
    "@anthropic-ai/sdk": "^0.134.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/client": "^2",
    "@modelcontextprotocol/server": "^2",
    "ai": "^7.0.143",
    "dotenv": "^18.0.8",
    "falkordb": "^6.8.0",
    "hono": "^4.13.13",
    "mcp-handler": "^2",
    "seedrandom": "^3.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/seedrandom": "^3.0.8",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "packageManager": "bun@1.3.14"
}
